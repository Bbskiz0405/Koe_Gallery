rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 上線鎖定：鎖住「前 lockedPages() 個拼貼頁」(page 0 … lockedPages()-1)。
    // 那幾頁的照片不能新增/移動/刪除。回傳 0 = 完全不鎖（與上線前行為相同）。
    // 上線當天把這個數字改成與 data.jsx 的 LOCKED_PAGES 相同，再 deploy。
    function lockedPages() { return 0; }
    function pageUnlocked(p) {
      return lockedPages() == 0 || (p is number && p >= lockedPages());
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['url', 'uploadedAt'])
                   && request.resource.data.url is string
                   && request.resource.data.url.size() < 1000
                   && request.resource.data.keys().size() <= 12
                   && pageUnlocked(request.resource.data.page);
      allow update: if request.resource.data.keys().size() <= 12
                   && pageUnlocked(resource.data.page)
                   && pageUnlocked(request.resource.data.page);
      allow delete: if pageUnlocked(resource.data.page);
    }

    // shared album metadata (e.g. number of collage pages)
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().size() <= 10;
    }

    match /stickers/{photoId} {
      allow read: if true;
      allow write: if request.resource.data.keys().size() <= 100;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['text', 'createdAt'])
                   && request.resource.data.text is string
                   && request.resource.data.text.size() <= 500
                   && request.resource.data.keys().size() <= 5;
      allow update, delete: if false;
    }

  }
}

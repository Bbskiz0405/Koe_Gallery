{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".claude/**",
      "uploads/**"
    ],
    "headers": [
      {
        "source": "**/*.jsx",
        "headers": [{ "key": "Content-Type", "value": "application/javascript" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
